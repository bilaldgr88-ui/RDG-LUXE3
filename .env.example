# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# RGD LUXE ADMIN & SECURITY CONFIGURATION (BACKEND ONLY)
# Replace placeholders before initial server setup or in hosting env vars.
# Never expose these values in frontend code or commit .env to git.
# ------------------------------------------------------------------
ADMIN_EMAIL="[ENTER YOUR ADMIN EMAIL HERE]"
ADMIN_PASSWORD="[ENTER YOUR NEW STRONG ADMIN PASSWORD HERE]"
ADMIN_RECOVERY_EMAIL="[ENTER YOUR PRIVATE RECOVERY EMAIL HERE]"
SESSION_SECRET="[ENTER_A_LONG_RANDOM_HEX_SECRET]"

# ------------------------------------------------------------------
# EMAIL DELIVERY SERVICE FOR ADMIN PASSWORD RECOVERY OTP
# Configure EITHER Resend API OR SMTP (Nodemailer).
# If neither is configured, OTP recovery returns an explicit configuration error.
# ------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="RGD LUXE Security <no-reply@yourdomain.com>"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
